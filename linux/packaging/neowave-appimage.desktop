# NeoWave — AppImage desktop entry.
# Same identity as neowave.desktop, but Exec is the bare binary name:
# inside the AppImage the executable lives at $APPDIR/usr/bin and there
# is no /opt/neowave (that absolute path belongs to the deb/rpm layout).
# Used ONLY by the CI AppImage step; see .github/workflows/desktop.yml.
[Desktop Entry]
Name=NeoWave
Comment=Desktop music player — YouTube Music, Last.fm scrobbling
Exec=neowave
Icon=neowave
Terminal=false
Type=Application
Categories=Audio;Music;AudioVideo;
StartupWMClass=neowave
